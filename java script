
// =====================================================
// 01. TO THE ETHER - HOMEPAGE CONTROLLER
// =====================================================

// These are the ten available feature pages.
const validFeatures = [
  "mood", "breathing", "gratitude", "fitness", "checkin",
  "study", "selfcare", "stories", "career", "world"
];

// =====================================================
// 02. SAFE STORAGE
// Saves information in this browser.
// =====================================================

function readStorage(key, fallback = null) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch {
    return fallback;
  }
}

function writeStorage(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
    return true;
  } catch {
    alert("Browser storage is full. Please use a smaller image or remove some saved items.");
    return false;
  }
}

// =====================================================
// 03. MOBILE NAVIGATION
// Opens and closes the menu.
// =====================================================

const menuToggle = document.getElementById("menuToggle");
const mainNav = document.getElementById("mainNav");

menuToggle?.addEventListener("click", () => {
  mainNav?.classList.toggle("open");
});

mainNav?.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    mainNav.classList.remove("open");
  });
});

// =====================================================
// 04. ACCOUNT MODAL
// Opens the local demo profile window.
// =====================================================

const accountModal = document.getElementById("accountModal");
const accountButton = document.getElementById("accountButton");
const closeModal = document.getElementById("closeModal");
const accountForm = document.getElementById("accountForm");

function openAccountModal() {
  accountModal?.classList.remove("hidden");
}

function closeAccountModal() {
  accountModal?.classList.add("hidden");
}

accountButton?.addEventListener("click", openAccountModal);
closeModal?.addEventListener("click", closeAccountModal);

accountModal?.addEventListener("click", event => {
  if (event.target === accountModal) closeAccountModal();
});

// =====================================================
// 05. FEATURE COUNT AND NAVIGATION
// Opens each card's individual page.
// =====================================================

function openFeature(feature) {
  if (!validFeatures.includes(feature)) return;

  const used = readStorage("etherUsedFeatures", []);

  if (!used.includes(feature)) {
    used.push(feature);
    writeStorage("etherUsedFeatures", used);
  }

  const profile = readStorage("etherProfile");

  // Three different features are available without a profile.
  if (used.length > 3 && !profile) {
    sessionStorage.setItem("etherPendingFeature", feature);
    openAccountModal();
    return;
  }

  window.location.href =
    "feature.html?feature=" + encodeURIComponent(feature);
}

// Card clicks work even when the user clicks on the text.
document.querySelectorAll(".feature-card").forEach(card => {
  card.addEventListener("click", event => {
    // Do not open the page when editing the photograph.
    if (event.target.closest(".card-background-button")) return;
    if (event.target.closest(".card-image-input")) return;

    openFeature(card.dataset.feature);
  });

  // Keyboard access for the cards.
  card.addEventListener("keydown", event => {
    if (event.target !== card) return;

    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      openFeature(card.dataset.feature);
    }
  });
});

// =====================================================
// 06. ACCOUNT CREATION
// Saves the profile and opens the pending feature.
// =====================================================

accountForm?.addEventListener("submit", event => {
  event.preventDefault();

  const name = document.getElementById("accountName").value.trim();
  const email = document.getElementById("accountEmail").value.trim();

  if (!name) return;

  const profile = { name, email, created: new Date().toISOString() };

  if (!writeStorage("etherProfile", profile)) return;

  document.getElementById("accountMessage").textContent =
    "Welcome, " + name + "! Your local profile is ready.";

  const pending = sessionStorage.getItem("etherPendingFeature");

  sessionStorage.removeItem("etherPendingFeature");

  setTimeout(() => {
    if (pending && validFeatures.includes(pending)) {
      window.location.href =
        "feature.html?feature=" + encodeURIComponent(pending);
    } else {
      closeAccountModal();
      accountButton.textContent = name + " ↗";
    }
  }, 600);
});

// =====================================================
// 07. RESTORE A PENDING FEATURE
// If the modal was closed, the user can still continue.
// =====================================================

closeModal?.addEventListener("click", () => {
  const pending = sessionStorage.getItem("etherPendingFeature");

  if (pending) {
    const continueButton = document.createElement("button");
    continueButton.className = "primary-button";
    continueButton.textContent = "Continue to your feature ↗";

    continueButton.addEventListener("click", () => {
      openFeature(pending);
    });

    document.getElementById("accountMessage")?.replaceChildren(continueButton);
  }
});

// =====================================================
// 08. CUSTOM CARD BACKGROUNDS
// Each card can have its own uploaded photograph.
// =====================================================

document.querySelectorAll("[data-background]").forEach(button => {
  button.addEventListener("click", event => {
    event.stopPropagation();

    const name = button.dataset.background;
    const input = document.querySelector(
      '[data-background-input="' + name + '"]'
    );

    input?.click();
  });
});

document.querySelectorAll("[data-background-input]").forEach(input => {
  input.addEventListener("change", () => {
    const file = input.files?.[0];
    const name = input.dataset.backgroundInput;

    if (!file || !file.type.startsWith("image/")) return;

    // Keep uploaded files reasonably small for browser storage.
    if (file.size > 1200000) {
      alert("Please choose an image smaller than 1.2 MB.");
      input.value = "";
      return;
    }

    const reader = new FileReader();

    reader.onload = () => {
      const backgrounds = readStorage("etherCardBackgrounds", {});
      backgrounds[name] = reader.result;

      if (writeStorage("etherCardBackgrounds", backgrounds)) {
        applyCardBackgrounds();
      }
    };

    reader.readAsDataURL(file);
  });
});

// Restores selected photographs after refreshing.
function applyCardBackgrounds() {
  const backgrounds = readStorage("etherCardBackgrounds", {});

  document.querySelectorAll(".feature-card").forEach(card => {
    const name = card.dataset.feature;
    const image = backgrounds[name];

    if (image) {
      card.style.setProperty(
        "--card-background-image",
        'url("' + image + '")'
      );
    }
  });
}

// =====================================================
// 09. SAVED PAGE LIBRARY
// Shows saved work from all ten feature pages.
// =====================================================

function displaySavedPages() {
  const container = document.getElementById("savedPages");
  if (!container) return;

  const pages = readStorage("etherSavedPages", []);
  container.replaceChildren();

  if (!pages.length) {
    container.textContent = "Your collection is waiting for its first page.";
    return;
  }

  pages.slice().reverse().forEach(page => {
    const item = document.createElement("article");
    item.className = "saved-item";

    const heading = document.createElement("h3");
    heading.textContent = page.title || "Untitled page";

    const date = document.createElement("small");
    date.textContent = page.date || "";

    const content = document.createElement("p");
    content.textContent = page.content || "";

    const openButton = document.createElement("button");
    openButton.textContent = "Open feature ↗";
    openButton.addEventListener("click", () => {
      window.location.href =
        "feature.html?feature=" + encodeURIComponent(page.feature || "world");
    });

    const removeButton = document.createElement("button");
    removeButton.textContent = "Delete page";
    removeButton.addEventListener("click", () => {
      if (!confirm("Delete this saved page?")) return;

      const updated = readStorage("etherSavedPages", [])
        .filter(entry => entry.id !== page.id);

      writeStorage("etherSavedPages", updated);
      displaySavedPages();
    });

    item.append(heading, date, content, openButton, removeButton);
    container.appendChild(item);
  });
}

// =====================================================
// 10. START THE HOMEPAGE
// =====================================================

applyCardBackgrounds();
displaySavedPages();

const profile = readStorage("etherProfile");

if (profile && accountButton) {
  accountButton.textContent = profile.name + " ↗";
}
