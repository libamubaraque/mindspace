
document.addEventListener("DOMContentLoaded", () => {

    // MOOD SELECTOR

    const moodButtons = document.querySelectorAll(".mood-option");
    const moodMessage = document.getElementById("mood-message");

    const moodMessages = {
        Happy: "Keep a little piece of this happiness with you. 🌿",
        Okay: "Okay is a perfectly valid place to be.",
        Tired: "Rest is productive too. Give yourself some time.",
        Overwhelmed: "Take one small step at a time. You don't need to solve everything now.",
        Unsure: "You don't need to have all the answers today."
    };

    moodButtons.forEach(button => {
        button.addEventListener("click", () => {
            moodButtons.forEach(item => item.classList.remove("selected"));
            button.classList.add("selected");

            const mood = button.dataset.mood;
            moodMessage.textContent = moodMessages[mood];
        });
    });


    // ACCOUNT SYSTEM - FRONT-END DEMO

    const modal = document.getElementById("account-modal");
    const closeModal = document.getElementById("close-modal");
    const guestButton = document.getElementById("guest-button");
    const accountForm = document.getElementById("account-form");

    let pendingDestination = "";

    function getUsedCards() {
        try {
            return JSON.parse(localStorage.getItem("etherUsedCards")) || [];
        } catch {
            return [];
        }
    }

    function continueToFeature() {
        if (pendingDestination) {
            const destination = pendingDestination;
            pendingDestination = "";
            window.location.href = destination;
        }
    }

    function closeAccountModal() {
        modal.classList.remove("show");
        continueToFeature();
    }

    // INTERCEPT FEATURE CARD CLICKS

    document.querySelectorAll(".feature-card").forEach(card => {

        card.addEventListener("click", event => {

            const destination = card.getAttribute("href");

            if (!destination) return;

            const cardName = new URL(destination, location.href)
                .searchParams.get("card");

            const usedCards = getUsedCards();
            const hasProfile = localStorage.getItem("etherProfile");

            if (!usedCards.includes(cardName)) {
                usedCards.push(cardName);
                localStorage.setItem(
                    "etherUsedCards",
                    JSON.stringify(usedCards)
                );
            }

            if (usedCards.length > 3 && !hasProfile) {
                event.preventDefault();
                pendingDestination = destination;
                modal.classList.add("show");
            }

        });

    });


    // CREATE A DEMONSTRATION PROFILE

    accountForm.addEventListener("submit", event => {

        event.preventDefault();

        const name = document.getElementById("profile-name").value.trim();
        const email = document.getElementById("profile-email").value.trim();

        if (!name || !email) return;

        localStorage.setItem("etherProfile", JSON.stringify({
            name: name,
            email: email
        }));

        alert("Welcome to your little world, " + name + "!");

        modal.classList.remove("show");

        continueToFeature();

    });


    // CONTINUE AS GUEST

    guestButton.addEventListener("click", closeAccountModal);

    closeModal.addEventListener("click", closeAccountModal);

    modal.addEventListener("click", event => {
        if (event.target === modal) {
            closeAccountModal();
        }
    });

});
