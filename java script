
/* =========================================================
   TO THE ETHER — HOMEPAGE JAVASCRIPT
   This file controls navigation, account pop-up, card colours
   and the homepage saved-pages collection.
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {
  // 01. SHORTCUT FOR FINDING HTML ELEMENTS BY THEIR ID
  const $ = id => document.getElementById(id);

  // 02. MOBILE NAVIGATION MENU
  $("menuToggle")?.addEventListener("click", () => {
    $("mainNav")?.classList.toggle("open");
  });

  document.querySelectorAll("#mainNav a").forEach(link => {
    link.addEventListener("click", () => {
      $("mainNav")?.classList.remove("open");
    });
  });

  // 03. READ THE SAVED DEMO PROFILE
  function getProfile() {
    try {
      return JSON.parse(localStorage.getItem("etherProfile")) || null;
    } catch {
      return null;
    }
  }

  // 04. ACCOUNT POP-UP OPEN AND CLOSE FUNCTIONS
  const modal = $("accountModal");

  function showModal(message = "") {
    $("accountMessage").textContent = message;
    modal.classList.add("show");
  }

  function closeModal() {
    modal.classList.remove("show");
  }

  $("accountButton")?.addEventListener("click", () => {
    const profile = getProfile();

    if (profile) {
      $("accountName").value = profile.name || "";
      $("accountEmail").value = profile.email || "";
      showModal("Your local demo profile is saved in this browser.");
    } else {
      showModal();
    }
  });

  $("closeModal")?.addEventListener("click", closeModal);

  modal?.addEventListener("click", event => {
    if (event.target === modal) closeModal();
  });

  // 05. CREATE OR UPDATE THE LOCAL DEMO PROFILE
  // This is not a real online account or secure login system.
  $("accountForm")?.addEventListener("submit", event => {
    event.preventDefault();

    const name = $("accountName").value.trim();
    const email = $("accountEmail").value.trim();

    if (!name) return;

    const profile = { name, email };

    try {
      localStorage.setItem("etherProfile", JSON.stringify(profile));
    } catch {
      $("accountMessage").textContent = "Your browser could not save this profile.";
      return;
    }

    $("accountButton").textContent = "Welcome, " + name;

    // If a visitor was waiting to open a card, open it now.
    const pendingFeature = sessionStorage.getItem("etherPendingFeature");

    if (pendingFeature) {
      sessionStorage.removeItem("etherPendingFeature");
      closeModal();

      window.location.href =
        "feature.html?feature=" + encodeURIComponent(pendingFeature);
      return;
    }

    $("accountMessage").textContent = "Your demo profile is ready!";
    setTimeout(closeModal, 1200);
  });

  // 06. UPDATE THE ACCOUNT BUTTON IF A PROFILE ALREADY EXISTS
  const existingProfile = getProfile();

  if (existingProfile?.name) {
    $("accountButton").textContent = "Welcome, " + existingProfile.name;
  }

  // 07. CARD NAVIGATION AND FEATURE USAGE TRACKING
  // Only the article card gets this click event.
  // This prevents the old duplicate-navigation problem.
  const cards = document.querySelectorAll(".feature-card");

  function openFeature(card) {
    const feature = card.dataset.feature;
    if (!feature) return;

    let usedFeatures = [];

    try {
      usedFeatures = JSON.parse(localStorage.getItem("etherUsedFeatures")) || [];
    } catch {
      usedFeatures = [];
    }

    // Count each different feature only once.
    if (!usedFeatures.includes(feature)) {
      usedFeatures.push(feature);

      try {
        localStorage.setItem("etherUsedFeatures", JSON.stringify(usedFeatures));
      } catch {
        // Navigation can still work if storage is unavailable.
      }
    }

    // Ask for a demo profile after more than three different features.
    const profile = getProfile();

    if (usedFeatures.length > 3 && !profile) {
      sessionStorage.setItem("etherPendingFeature", feature);
      showModal("You've explored more than three spaces. Create a local demo profile to continue.");
      return;
    }

    // Open the shared feature page with the selected feature name.
    window.location.href =
      "feature.html?feature=" + encodeURIComponent(feature);
  }

  cards.forEach(card => {
    card.addEventListener("click", () => openFeature(card));

    // Keyboard access: Enter or Space opens the selected card.
    card.addEventListener("keydown", event => {
      if (event.target !== card) return;

      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openFeature(card);
      }
    });
  });

  // 08. CUSTOMISE EACH HOMEPAGE CARD'S BACKGROUND COLOUR
  cards.forEach(card => {
    const feature = card.dataset.feature;
    const storageKey = "etherBackground_" + feature;

    let savedColour = localStorage.getItem(storageKey);

    // Use a saved colour only if it is a valid six-digit hex colour.
    if (savedColour && /^#[0-9a-f]{6}$/i.test(savedColour)) {
      card.style.background = savedColour;
    } else {
      savedColour = "";
    }

    // Add a small colour picker to the card.
    const control = document.createElement("div");
    control.className = "background-control";

    const label = document.createElement("span");
    label.textContent = "Choose colour";

    const picker = document.createElement("input");
    picker.type = "color";
    picker.value = savedColour || "#71845a";
    picker.setAttribute("aria-label", "Choose card background colour");

    // Do not open the feature when someone uses the colour picker.
    picker.addEventListener("click", event => event.stopPropagation());

    picker.addEventListener("keydown", event => event.stopPropagation());

    picker.addEventListener("input", event => {
      event.stopPropagation();
      card.style.background = picker.value;

      try {
        localStorage.setItem(storageKey, picker.value);
      } catch {
        // The card colour still changes for this visit.
      }
    });

    control.append(label, picker);
    card.appendChild(control);
  });

  // 09. DISPLAY ALL SAVED PAGES ON THE HOMEPAGE
  function renderSavedPages() {
    const container = $("savedPages");
    if (!container) return;

    let pages = [];

    try {
      pages = JSON.parse(localStorage.getItem("etherSavedPages")) || [];
    } catch {
      pages = [];
    }

    container.innerHTML = "";

    if (!pages.length) {
      const empty = document.createElement("p");
      empty.textContent = "Your saved pages will appear here.";
      container.appendChild(empty);
      return;
    }

    pages.slice().reverse().forEach(page => {
      const item = document.createElement("article");
      item.className = "saved-item";

      const heading = document.createElement("h3");
      heading.textContent = page.title || "My page";

      const text = document.createElement("p");
      text.textContent = page.content || "";

      const date = document.createElement("small");
      date.textContent = page.date || "";

      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Delete";

      remove.addEventListener("click", () => {
        pages = pages.filter(savedPage => savedPage.id !== page.id);

        try {
          localStorage.setItem("etherSavedPages", JSON.stringify(pages));
          renderSavedPages();
        } catch {
          alert("Could not update your saved pages.");
        }
      });

      item.append(heading, text, date, remove);
      container.appendChild(item);
    });
  }

  // 10. LOAD SAVED PAGES WHEN THE HOMEPAGE OPENS
  renderSavedPages();
});
