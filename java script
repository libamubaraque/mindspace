
/* =========================================================
   TO THE ETHER — HOMEPAGE JAVASCRIPT
   Complete corrected version
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {

  /* 01. SHORTCUTS */
  const $ = id => document.getElementById(id);

  const menuToggle = $("menuToggle");
  const mainNav = $("mainNav");

  const accountButton = $("accountButton");
  const accountModal = $("accountModal");
  const closeModal = $("closeModal");
  const accountForm = $("accountForm");

  const accountName = $("accountName");
  const accountEmail = $("accountEmail");
  const accountMessage = $("accountMessage");

  const savedPagesContainer = $("savedPages");

  let pendingFeature = null;

  /* 02. SAFE LOCAL STORAGE */
  function readStorage(key, fallback = null) {
    try {
      const value = localStorage.getItem(key);
      return value === null ? fallback : JSON.parse(value);
    } catch (error) {
      console.warn("Storage reading error:", key, error);
      return fallback;
    }
  }

  function writeStorage(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
      return true;
    } catch (error) {
      console.warn("Storage saving error:", key, error);
      return false;
    }
  }

  /* 03. PROFILE */
  function getProfile() {
    const profile = readStorage("etherProfile");

    if (
      !profile ||
      typeof profile !== "object" ||
      typeof profile.name !== "string"
    ) {
      return null;
    }

    return profile;
  }

  function updateAccountButton() {
    const profile = getProfile();

    if (profile && accountButton) {
      accountButton.textContent =
        "Welcome, " + profile.name + " ↗";
    }
  }

  /* 04. MOBILE NAVIGATION */
  if (menuToggle && mainNav) {

    menuToggle.setAttribute("aria-expanded", "false");

    menuToggle.addEventListener("click", () => {

      const isOpen = mainNav.classList.toggle("active");

      menuToggle.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

      menuToggle.textContent = isOpen ? "✕" : "☰";

    });

    mainNav.querySelectorAll("a").forEach(link => {

      link.addEventListener("click", () => {

        mainNav.classList.remove("active");

        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.textContent = "☰";

      });

    });

  }

  /* 05. ACCOUNT MODAL */
  function showModal(message = "") {

    if (!accountModal) return;

    accountModal.classList.add("active");
    accountModal.setAttribute("aria-hidden", "false");

    if (accountMessage) {
      accountMessage.textContent = message;
    }

    if (accountName) {
      accountName.focus();
    }

  }

  function hideModal() {

    if (!accountModal) return;

    accountModal.classList.remove("active");
    accountModal.setAttribute("aria-hidden", "true");

    pendingFeature = null;

  }

  if (accountModal) {
    accountModal.setAttribute("aria-hidden", "true");
  }

  if (accountButton) {

    accountButton.addEventListener("click", () => {

      const profile = getProfile();

      if (profile) {

        if (accountName) {
          accountName.value = profile.name;
        }

        if (accountEmail) {
          accountEmail.value = profile.email || "";
        }

        showModal("Welcome back, " + profile.name + "!");

      } else {

        showModal();

      }

    });

  }

  if (closeModal) {
    closeModal.addEventListener("click", hideModal);
  }

  if (accountModal) {

    accountModal.addEventListener("click", event => {

      if (event.target === accountModal) {
        hideModal();
      }

    });

  }

  document.addEventListener("keydown", event => {

    if (event.key === "Escape") {

      if (
        accountModal &&
        accountModal.classList.contains("active")
      ) {
        hideModal();
      }

    }

  });

  /* 06. SAVE DEMO PROFILE */
  if (accountForm) {

    accountForm.addEventListener("submit", event => {

      event.preventDefault();

      const name = accountName
        ? accountName.value.trim()
        : "";

      const email = accountEmail
        ? accountEmail.value.trim()
        : "";

      if (!name) {

        if (accountMessage) {
          accountMessage.textContent =
            "Please enter your name.";
        }

        return;

      }

      const profile = {
        name: name,
        email: email,
        createdAt: new Date().toISOString()
      };

      const saved = writeStorage("etherProfile", profile);

      if (!saved) {

        if (accountMessage) {
          accountMessage.textContent =
            "Your browser could not save your profile.";
        }

        return;

      }

      updateAccountButton();

      if (accountMessage) {
        accountMessage.textContent =
          "Your demo profile is ready!";
      }

      if (pendingFeature) {

        const feature = pendingFeature;
        pendingFeature = null;

        addUsedFeature(feature);

        setTimeout(() => {

          hideModal();
          openFeature(feature);

        }, 500);

      } else {

        setTimeout(hideModal, 900);

      }

    });

  }

  /* 07. FEATURE HISTORY */
  function getUsedFeatures() {

    const data = readStorage("etherUsedFeatures", []);

    return Array.isArray(data) ? data : [];

  }

  function addUsedFeature(feature) {

    if (!feature) return;

    const used = getUsedFeatures();

    if (!used.includes(feature)) {

      used.push(feature);

      writeStorage("etherUsedFeatures", used);

    }

  }

  /* 08. OPEN FEATURE PAGE */
  function openFeature(card) {

    const destination = card.getAttribute("href");

    if (destination) {

      window.location.href = destination;

    } else {

      const feature = card.dataset.feature;

      if (feature) {

        window.location.href =
          "feature.html?feature=" +
          encodeURIComponent(feature);

      }

    }

  }

  /* 09. FEATURE CARD NAVIGATION */
  const featureCards = document.querySelectorAll(
    ".feature-card[data-feature]"
  );

  featureCards.forEach(card => {

    card.addEventListener("click", event => {

      // Preserve normal browser link behaviour.
      if (
        event.button !== 0 ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const feature = card.dataset.feature;

      if (!feature) return;

      const profile = getProfile();
      const used = getUsedFeatures();

      // Existing profile: unrestricted demo access.
      if (profile) {

        event.preventDefault();

        addUsedFeature(feature);
        openFeature(card);

        return;

      }

      // Returning to an already explored space.
      if (used.includes(feature)) {

        event.preventDefault();

        openFeature(card);

        return;

      }

      // Require a demo profile after three different spaces.
      if (used.length >= 3) {

        event.preventDefault();

        pendingFeature = feature;

        showModal(
          "You've explored three spaces! Create a little demo profile to continue."
        );

        return;

      }

      // First three different spaces are free.
      event.preventDefault();

      addUsedFeature(feature);
      openFeature(card);

    });

  });

  /* 10. LOAD EXISTING ACCOUNT */
  updateAccountButton();

  /* 11. SAVED CREATIONS */
  function getSavedPages() {

    const pages = readStorage("etherSavedPages", []);

    return Array.isArray(pages) ? pages : [];

  }

  function renderSavedPages() {

    if (!savedPagesContainer) return;

    savedPagesContainer.innerHTML = "";

    const pages = getSavedPages();

    if (pages.length === 0) {

      const message = document.createElement("p");

      message.className = "empty-saved-message";

      message.textContent =
        "Your saved creations will appear here.";

      savedPagesContainer.appendChild(message);

      return;

    }

    pages.forEach((page, index) => {

      const card = document.createElement("article");

      card.className = "saved-page-card";

      const heading = document.createElement("h3");

      heading.textContent =
        page.title || "My saved page";

      const content = document.createElement("p");

      content.textContent =
        page.content || "";

      const date = document.createElement("small");

      if (page.date) {

        const parsed = new Date(page.date);

        date.textContent = !isNaN(parsed.getTime())
          ? parsed.toLocaleDateString()
          : "";

      }

      const deleteButton = document.createElement("button");

      deleteButton.className = "delete-saved-page";
      deleteButton.textContent = "Delete";
      deleteButton.type = "button";

      deleteButton.addEventListener("click", () => {

        const updated = getSavedPages();

        updated.splice(index, 1);

        if (writeStorage("etherSavedPages", updated)) {

          renderSavedPages();

        } else {

          alert("Could not delete this page.");

        }

      });

      card.append(
        heading,
        content,
        date,
        deleteButton
      );

      savedPagesContainer.appendChild(card);

    });

  }

  /* 12. INITIALISE SAVED PAGES */
  renderSavedPages();

  /* 13. STORAGE SYNCHRONISATION */
  window.addEventListener("storage", event => {

    if (
      event.key === "etherSavedPages" ||
      event.key === "etherProfile"
    ) {

      renderSavedPages();
      updateAccountButton();

    }

  });

  console.log(
    "To the Ether homepage loaded successfully."
  );

});
