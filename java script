
/* =========================================================
   TO THE ETHER — HOMEPAGE JAVASCRIPT
   ========================================================= */

document.addEventListener("DOMContentLoaded", () => {

  const $ = id => document.getElementById(id);

  /* 01. MOBILE NAVIGATION */
  const menuToggle = $("menuToggle");
  const mainNav = $("mainNav");

  if (menuToggle && mainNav) {
    menuToggle.addEventListener("click", () => {
      mainNav.classList.toggle("active");
    });

    mainNav.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        mainNav.classList.remove("active");
      });
    });
  }

  /* 02. ACCOUNT ELEMENTS */
  const accountButton = $("accountButton");
  const accountModal = $("accountModal");
  const closeModal = $("closeModal");
  const accountForm = $("accountForm");
  const accountName = $("accountName");
  const accountEmail = $("accountEmail");
  const accountMessage = $("accountMessage");

  let pendingFeature = null;

  /* 03. READ THE DEMO PROFILE */
  function getProfile() {
    try {
      return JSON.parse(localStorage.getItem("etherProfile")) || null;
    } catch {
      return null;
    }
  }

  /* 04. SHOW AND HIDE ACCOUNT POP-UP */
  function showModal(message = "") {
    if (!accountModal) return;

    accountModal.classList.add("active");

    if (accountMessage) {
      accountMessage.textContent = message;
    }
  }

  function hideModal() {
    if (!accountModal) return;
    accountModal.classList.remove("active");
  }

  if (accountButton) {
    accountButton.addEventListener("click", () => {
      const profile = getProfile();

      if (profile) {
        if (accountName) accountName.value = profile.name;
        if (accountEmail) accountEmail.value = profile.email || "";

        showModal("Welcome back, " + profile.name + "!");
      } else {
        showModal();
      }
    });
  }

  if (closeModal) {
    closeModal.addEventListener("click", hideModal);
  }

  if (accountModal) {
    accountModal.addEventListener("click", event => {
      if (event.target === accountModal) hideModal();
    });
  }

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") hideModal();
  });

  /* 05. SAVE DEMO PROFILE */
  if (accountForm) {
    accountForm.addEventListener("submit", event => {
      event.preventDefault();

      const name = accountName.value.trim();
      const email = accountEmail.value.trim();

      if (!name) {
        accountMessage.textContent = "Please enter your name.";
        return;
      }

      const profile = {
        name,
        email,
        createdAt: new Date().toISOString()
      };

      try {
        localStorage.setItem("etherProfile", JSON.stringify(profile));
      } catch {
        accountMessage.textContent =
          "Your browser could not save your profile.";
        return;
      }

      if (accountButton) {
        accountButton.textContent = "Welcome, " + name + " ↗";
      }

      accountMessage.textContent = "Your demo profile is ready!";

      if (pendingFeature) {
        const feature = pendingFeature;
        pendingFeature = null;

        addUsedFeature(feature);

        setTimeout(() => {
          hideModal();
          openFeature(feature);
        }, 500);
      } else {
        setTimeout(hideModal, 900);
      }
    });
  }

  /* 06. TRACK DIFFERENT FEATURES */
  function getUsedFeatures() {
    try {
      const data = JSON.parse(
        localStorage.getItem("etherUsedFeatures")
      );

      return Array.isArray(data) ? data : [];
    } catch {
      return [];
    }
  }

  function addUsedFeature(feature) {
    const used = getUsedFeatures();

    if (!used.includes(feature)) {
      used.push(feature);
    }

    try {
      localStorage.setItem("etherUsedFeatures", JSON.stringify(used));
    } catch (error) {
      console.warn("Could not save feature history.", error);
    }
  }

  /* 07. OPEN FEATURE PAGE */
  function openFeature(feature) {
    window.location.href =
      "feature.html?feature=" + encodeURIComponent(feature);
  }

  /* 08. CARD CLICK EVENTS */
  const featureCards = document.querySelectorAll(".feature-card");

  featureCards.forEach(card => {

    card.addEventListener("click", event => {

      const feature = card.dataset.feature;

      if (!feature) {
        event.preventDefault();
        return;
      }

      const profile = getProfile();
      const used = getUsedFeatures();

      // Existing profile: allow entry.
      if (profile) {
        event.preventDefault();
        addUsedFeature(feature);
        openFeature(feature);
        return;
      }

      // First three different spaces: free demo access.
      if (!used.includes(feature) && used.length >= 3) {
        event.preventDefault();

        pendingFeature = feature;

        showModal(
          "You've explored three spaces! Create a little demo profile to continue."
        );

        return;
      }

      // Allow the first three spaces.
      event.preventDefault();
      addUsedFeature(feature);
      openFeature(feature);

    });

  });

  /* 09. UPDATE ACCOUNT BUTTON */
  const savedProfile = getProfile();

  if (savedProfile && accountButton) {
    accountButton.textContent =
      "Welcome, " + savedProfile.name + " ↗";
  }

  /* 10. DISPLAY SAVED CREATIONS */
  const savedPagesContainer = $("savedPages");

  function renderSavedPages() {

    if (!savedPagesContainer) return;

    savedPagesContainer.innerHTML = "";

    let pages = [];

    try {
      pages = JSON.parse(
        localStorage.getItem("etherSavedPages")
      ) || [];
    } catch {
      pages = [];
    }

    if (!Array.isArray(pages) || pages.length === 0) {
      const message = document.createElement("p");
      message.className = "empty-saved-message";
      message.textContent =
        "Your saved creations will appear here.";

      savedPagesContainer.appendChild(message);
      return;
    }

    pages.forEach((page, index) => {

      const card = document.createElement("article");
      card.className = "saved-page-card";

      const heading = document.createElement("h3");
      heading.textContent = page.title || "My saved page";

      const content = document.createElement("p");
      content.textContent = page.content || "";

      const date = document.createElement("small");

      if (page.date) {
        const parsed = new Date(page.date);

        date.textContent = isNaN(parsed.getTime())
          ? ""
          : parsed.toLocaleDateString();
      }

      const deleteButton = document.createElement("button");
      deleteButton.className = "delete-saved-page";
      deleteButton.textContent = "Delete";
      deleteButton.type = "button";

      deleteButton.addEventListener("click", () => {

        const updated = pages.filter((item, i) => i !== index);

        try {
          localStorage.setItem(
            "etherSavedPages",
            JSON.stringify(updated)
          );

          renderSavedPages();
        } catch {
          alert("Could not delete this page.");
        }

      });

      card.append(heading, content, date, deleteButton);
      savedPagesContainer.appendChild(card);

    });
  }

  renderSavedPages();

  console.log("To the Ether homepage loaded successfully.");

});
