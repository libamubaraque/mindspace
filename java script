
document.addEventListener("DOMContentLoaded", () => {
  const $ = (id) => document.getElementById(id);

  const menuToggle = $("menuToggle");
  const mainNav = $("mainNav");

  if (menuToggle && mainNav) {
    menuToggle.addEventListener("click", () => {
      mainNav.classList.toggle("open");
    });

    mainNav.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => mainNav.classList.remove("open"));
    });
  }

  const modal = $("accountModal");
  const accountButton = $("accountButton");
  const closeModal = $("closeModal");
  const accountForm = $("accountForm");

  function getProfile() {
    try {
      return JSON.parse(localStorage.getItem("etherProfile")) || null;
    } catch {
      return null;
    }
  }

  function showModal() {
    modal?.classList.add("show");
  }

  function hideModal() {
    modal?.classList.remove("show");
  }

  accountButton?.addEventListener("click", () => {
    const profile = getProfile();

    if (profile) {
      alert("Welcome back, " + profile.name + "!");
    } else {
      showModal();
    }
  });

  closeModal?.addEventListener("click", hideModal);

  modal?.addEventListener("click", event => {
    if (event.target === modal) hideModal();
  });

  accountForm?.addEventListener("submit", event => {
    event.preventDefault();

    const name = $("accountName").value.trim();
    const email = $("accountEmail").value.trim();

    if (!name) return;

    const profile = { name, email, created: new Date().toISOString() };

    localStorage.setItem("etherProfile", JSON.stringify(profile));

    $("accountMessage").textContent =
      "Your local demo profile has been created. Welcome, " + name + "!";

    accountButton.textContent = "Welcome, " + name;
    setTimeout(hideModal, 1500);
  });

  const cards = document.querySelectorAll("[data-feature]");

  function getUsedFeatures() {
    try {
      return JSON.parse(localStorage.getItem("etherUsedFeatures")) || [];
    } catch {
      return [];
    }
  }

  function openFeature(feature) {
    let used = getUsedFeatures();

    if (!used.includes(feature)) {
      used.push(feature);
      localStorage.setItem("etherUsedFeatures", JSON.stringify(used));
    }

    const profile = getProfile();

    // Ask for a profile after the user has explored
    // more than three different feature spaces.
    if (used.length > 3 && !profile) {
      sessionStorage.setItem("etherPendingFeature", feature);
      showModal();
      $("accountMessage").textContent =
        "You've explored more than three spaces. Create a profile to continue.";
      return;
    }

    window.location.href =
      "feature.html?feature=" + encodeURIComponent(feature);
  }

  cards.forEach(card => {
    card.addEventListener("click", event => {
      if (event.target.closest("a")) return;

      const feature = card.dataset.feature;
      if (feature) openFeature(feature);
    });
  });

  // Also support clicking the card's button.
  document.querySelectorAll(".card-open").forEach(button => {
    button.addEventListener("click", event => {
      event.stopPropagation();
      openFeature(button.dataset.feature);
    });
  });

  accountForm?.addEventListener("submit", event => {
    // The profile is stored by the submit handler above.
    // Resume the feature that triggered registration.
    setTimeout(() => {
      const pending = sessionStorage.getItem("etherPendingFeature");

      if (pending) {
        sessionStorage.removeItem("etherPendingFeature");
        window.location.href =
          "feature.html?feature=" + encodeURIComponent(pending);
      }
    }, 1600);
  });

  // Custom homepage card backgrounds.
  // Saved separately for each card in this browser.
  const cardsForBackground = document.querySelectorAll(".feature-card");

  cardsForBackground.forEach(card => {
    const feature = card.dataset.feature;
    const key = "etherBackground_" + feature;
    const saved = localStorage.getItem(key);

    if (saved && /^#[0-9a-f]{6}$/i.test(saved)) {
      card.style.background = saved;
    }

    const picker = document.createElement("input");
    picker.type = "color";
    picker.className = "background-picker";
    picker.value = saved || "#303b2b";
    picker.title = "Choose this card's background";
    picker.setAttribute("aria-label", "Choose card background");

    const label = document.createElement("label");
    label.className = "background-control";
    label.textContent = "Colour ";
    label.appendChild(picker);

    card.appendChild(label);

    picker.addEventListener("input", () => {
      card.style.background = picker.value;
      localStorage.setItem(key, picker.value);
    });
  });

  // Display saved pages on homepage.
  function renderSavedPages() {
    const container = $("savedPages");
    if (!container) return;

    let pages = [];

    try {
      pages = JSON.parse(localStorage.getItem("etherSavedPages")) || [];
    } catch {
      pages = [];
    }

    container.innerHTML = "";

    if (!pages.length) {
      container.innerHTML =
        '<p class="empty-message">Your saved pages will appear here when you create them.</p>';
      return;
    }

    pages.slice().reverse().forEach((page, index) => {
      const item = document.createElement("article");
      item.className = "saved-item";

      const title = document.createElement("h3");
      title.textContent = page.title || "My page";

      const content = document.createElement("p");
      content.textContent = page.content || "";

      const date = document.createElement("small");
      date.textContent = page.date || "";

      const remove = document.createElement("button");
      remove.textContent = "Delete page";
      remove.addEventListener("click", () => {
        const originalIndex = pages.length - 1 - index;
        pages.splice(originalIndex, 1);
        localStorage.setItem("etherSavedPages", JSON.stringify(pages));
        renderSavedPages();
      });

      item.append(title, content, date, remove);
      container.appendChild(item);
    });
  }

  renderSavedPages();

  // Reveal animation.
  const revealElements = document.querySelectorAll(
    ".feature-card, .story-card, .intro-section, .resource-links a"
  );

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    revealElements.forEach(element => {
      element.classList.add("reveal");
      observer.observe(element);
    });
  }
});
