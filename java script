
/* =========================================
   TO THE ETHER — MAIN WEBSITE
   ========================================= */

const ETHER = {
    storage: "etherWebsiteDataV1",

    getData() {
        try {
            return JSON.parse(localStorage.getItem(this.storage)) || {
                profile: null,
                usedFeatures: [],
                savedPages: [],
                backgrounds: {}
            };
        } catch {
            return {
                profile: null,
                usedFeatures: [],
                savedPages: [],
                backgrounds: {}
            };
        }
    },

    data: null,

    save() {
        try {
            localStorage.setItem(this.storage, JSON.stringify(this.data));
            return true;
        } catch (error) {
            alert("Browser storage is full or unavailable. Try using smaller images.");
            return false;
        }
    },

    notify(message) {
        const notice = document.getElementById("notice");
        if (!notice) return;

        notice.textContent = message;
        notice.classList.add("show");

        clearTimeout(this.noticeTimer);
        this.noticeTimer = setTimeout(() => {
            notice.classList.remove("show");
        }, 2800);
    },

    savePage(title, text, category) {
        this.data.savedPages.unshift({
            id: Date.now() + Math.random(),
            title,
            text,
            category,
            date: new Date().toISOString()
        });

        if (this.save()) {
            this.notify("Your page has been saved ✨");
        }
        renderSavedPages();
    }
};

ETHER.data = ETHER.getData();

const featureNames = {
    mood: "Mood Journal",
    breathing: "Breathing Space",
    gratitude: "Gratitude Journal",
    fitness: "Fitness & Wellness",
    checkin: "Daily Check-in",
    study: "Study & Focus",
    selfcare: "Self-care Corner",
    support: "Health & Support",
    career: "Find Your Direction",
    myworld: "My Little World"
};

/* -----------------------------------------
   FEATURE ACCESS
   First three unique spaces are free.
   Fourth and later require a local profile.
   ----------------------------------------- */

function openFeature(feature) {
    if (!featureNames[feature]) return;

    const used = ETHER.data.usedFeatures;

    if (!used.includes(feature) && used.length >= 3 && !ETHER.data.profile) {
        const modal = document.getElementById("accountModal");

        if (modal) {
            modal.classList.add("show");
            modal.setAttribute("aria-hidden", "false");
        } else {
            sessionStorage.setItem("pendingFeature", feature);
            window.location.href = "index.html?account=required";
        }
        return;
    }

    if (!used.includes(feature)) {
        used.push(feature);
        ETHER.save();
    }

    window.location.href = "feature.html?feature=" + encodeURIComponent(feature);
}

/* -----------------------------------------
   ACCOUNT MODAL
   ----------------------------------------- */

function closeAccountModal() {
    const modal = document.getElementById("accountModal");
    if (!modal) return;

    modal.classList.remove("show");
    modal.setAttribute("aria-hidden", "true");
}

function createLocalProfile(event) {
    event.preventDefault();

    const name = document.getElementById("accountName").value.trim();
    const email = document.getElementById("accountEmail").value.trim();

    if (!name) return;

    ETHER.data.profile = {
        name,
        email,
        created: new Date().toISOString()
    };

    if (!ETHER.save()) return;

    closeAccountModal();
    ETHER.notify("Welcome to your little world, " + name + "!");

    const pending = sessionStorage.getItem("pendingFeature");

    if (pending) {
        sessionStorage.removeItem("pendingFeature");
        setTimeout(() => openFeature(pending), 500);
    }
}

/* -----------------------------------------
   SAVED PAGES LIBRARY
   ----------------------------------------- */

function renderSavedPages() {
    const container = document.getElementById("savedPages");
    if (!container) return;

    container.innerHTML = "";

    if (!ETHER.data.savedPages.length) {
        container.innerHTML =
            '<p class="empty-state">Your saved pages will appear here.</p>';
        return;
    }

    ETHER.data.savedPages.forEach(page => {
        const card = document.createElement("article");
        card.className = "saved-card";

        const heading = document.createElement("h3");
        heading.textContent = page.title;

        const category = document.createElement("small");
        category.textContent =
            page.category + " · " + new Date(page.date).toLocaleString();

        const content = document.createElement("p");
        content.textContent = page.text;

        const remove = document.createElement("button");
        remove.className = "tool-button";
        remove.textContent = "Delete page";

        remove.addEventListener("click", () => {
            if (!confirm("Delete this saved page?")) return;

            ETHER.data.savedPages =
                ETHER.data.savedPages.filter(item => item.id !== page.id);

            ETHER.save();
            renderSavedPages();
        });

        card.append(heading, category, content, remove);
        container.appendChild(card);
    });
}

/* -----------------------------------------
   CUSTOM CARD BACKGROUNDS
   ----------------------------------------- */

function applyBackgrounds() {
    document.querySelectorAll(".feature-card").forEach(card => {
        const id = card.dataset.feature;
        const saved = ETHER.data.backgrounds[id];

        if (!saved) return;

        if (saved.color) card.style.setProperty("--card-bg", saved.color);

        if (saved.image) {
            card.style.backgroundImage =
                `linear-gradient(rgba(20,15,18,.55),rgba(20,15,18,.75)),url("${saved.image}")`;
        }
    });
}

function setupCardCustomisation() {
    document.querySelectorAll(".feature-card").forEach(card => {
        const id = card.dataset.feature;
        const colour = card.querySelector(".card-color");
        const image = card.querySelector(".card-image");

        if (colour) {
            colour.addEventListener("input", () => {
                card.style.setProperty("--card-bg", colour.value);

                ETHER.data.backgrounds[id] = {
                    ...ETHER.data.backgrounds[id],
                    color: colour.value
                };

                ETHER.save();
            });
        }

        if (image) {
            image.addEventListener("change", () => {
                const file = image.files[0];
                if (!file) return;

                if (!file.type.startsWith("image/")) {
                    ETHER.notify("Please choose an image.");
                    return;
                }

                if (file.size > 900000) {
                    ETHER.notify("Please choose an image smaller than 900 KB.");
                    image.value = "";
                    return;
                }

                const reader = new FileReader();

                reader.onload = () => {
                    card.style.backgroundImage =
                        `linear-gradient(rgba(20,15,18,.45),rgba(20,15,18,.7)),url("${reader.result}")`;

                    ETHER.data.backgrounds[id] = {
                        ...ETHER.data.backgrounds[id],
                        image: reader.result
                    };

                    ETHER.save();
                    ETHER.notify("Your card background has changed!");
                };

                reader.readAsDataURL(file);
            });
        }
    });
}

/* -----------------------------------------
   PAGE INITIALISATION
   ----------------------------------------- */

document.addEventListener("DOMContentLoaded", () => {
    renderSavedPages();
    applyBackgrounds();
    setupCardCustomisation();

    document.querySelectorAll(".feature-card > a").forEach(link => {
        link.addEventListener("click", event => {
            event.preventDefault();
            openFeature(link.closest(".feature-card").dataset.feature);
        });
    });

    const form = document.getElementById("accountForm");
    if (form) form.addEventListener("submit", createLocalProfile);

    const close = document.getElementById("closeModal");
    if (close) close.addEventListener("click", closeAccountModal);

    const modal = document.getElementById("accountModal");
    if (modal) {
        modal.addEventListener("click", event => {
            if (event.target === modal) closeAccountModal();
        });
    }

    if (new URLSearchParams(location.search).get("account") === "required") {
        const modal = document.getElementById("accountModal");
        if (modal) modal.classList.add("show");
    }

    const pending = sessionStorage.getItem("pendingFeature");
    if (pending && document.getElementById("accountModal")) {
        document.getElementById("accountModal").classList.add("show");
    }
});
