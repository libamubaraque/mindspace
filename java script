const featureNames = [
    "mood", "breathing", "gratitude", "fitness", "checkin",
    "study", "selfcare", "stories", "career", "world"
];

/* Safe local storage helpers */

function readData(key, fallback) {
    try {
        const value = localStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
    } catch (error) {
        return fallback;
    }
}

function writeData(key, value) {
    try {
        localStorage.setItem(key, JSON.stringify(value));
        return true;
    } catch (error) {
        alert("Browser storage is full or unavailable. Please try again.");
        return false;
    }
}

/* Open feature pages */

function openFeature(feature) {
    if (!featureNames.includes(feature)) {
        alert("This feature could not be found.");
        return;
    }

    let used = readData("etherUsedFeatures", []);

    if (!Array.isArray(used)) used = [];

    if (!used.includes(feature)) {
        used.push(feature);
        writeData("etherUsedFeatures", used);
    }

    const profile = readData("etherProfile", null);

    // Ask for a demo profile when opening the fourth different feature.
    if (used.length > 3 && !profile) {
        sessionStorage.setItem("etherPendingFeature", feature);
        showAccountModal();
        return;
    }

    window.location.href = "feature.html?feature=" + encodeURIComponent(feature);
}

/* Card click handling */

document.addEventListener("click", function (event) {
    const card = event.target.closest(".feature-card[data-feature]");

    if (!card) return;

    openFeature(card.dataset.feature);
});

/* Keyboard access */

document.addEventListener("keydown", function (event) {
    if (event.key !== "Enter" && event.key !== " ") return;

    const card = event.target.closest(".feature-card[data-feature]");

    if (!card || event.target !== card) return;

    event.preventDefault();
    openFeature(card.dataset.feature);
});

/* Account modal */

function showAccountModal() {
    const modal = document.getElementById("accountModal");

    if (!modal) {
        alert("Please create a demo profile to continue.");
        return;
    }

    modal.classList.add("show");
    modal.setAttribute("aria-hidden", "false");
}

function hideAccountModal() {
    const modal = document.getElementById("accountModal");

    if (!modal) return;

    modal.classList.remove("show");
    modal.setAttribute("aria-hidden", "true");
}

document.addEventListener("click", function (event) {
    if (event.target.closest("#closeAccountModal")) {
        hideAccountModal();
    }

    if (event.target.id === "accountModal") {
        hideAccountModal();
    }

    if (event.target.closest("#menuToggle")) {
        document.querySelector(".nav-links")?.classList.toggle("show");
    }
});

/* Demo profile form */

document.addEventListener("submit", function (event) {
    if (event.target.id !== "accountForm") return;

    event.preventDefault();

    const name = document.getElementById("accountName").value.trim();
    const email = document.getElementById("accountEmail").value.trim();

    if (!name || !email) {
        alert("Please fill in both fields.");
        return;
    }

    const profile = {
        name: name,
        email: email,
        createdAt: new Date().toISOString()
    };

    if (!writeData("etherProfile", profile)) return;

    hideAccountModal();

    const nextFeature = sessionStorage.getItem("etherPendingFeature");
    sessionStorage.removeItem("etherPendingFeature");

    if (nextFeature && featureNames.includes(nextFeature)) {
        window.location.href =
            "feature.html?feature=" + encodeURIComponent(nextFeature);
    } else {
        alert("Your demo profile is ready!");
    }
});

/* Saved pages */

function saveEtherPage(title, content) {
    const pages = readData("etherSavedPages", []);

    pages.unshift({
        id: Date.now(),
        title: title,
        content: content,
        date: new Date().toLocaleString()
    });

    return writeData("etherSavedPages", pages);
}

function showSavedPages() {
    const container = document.getElementById("savedPagesList");

    if (!container) return;

    const pages = readData("etherSavedPages", []);

    container.innerHTML = "";

    if (!pages.length) {
        const empty = document.createElement("p");
        empty.className = "empty-saved-message";
        empty.textContent = "Your saved pages will appear here.";
        container.appendChild(empty);
        return;
    }

    pages.forEach(function (page) {
        const item = document.createElement("article");
        item.className = "saved-page-item";

        const heading = document.createElement("h3");
        heading.textContent = page.title;

        const date = document.createElement("small");
        date.textContent = page.date;

        const content = document.createElement("p");
        content.textContent = page.content;

        const remove = document.createElement("button");
        remove.className = "delete-saved-page";
        remove.textContent = "Delete";
        remove.dataset.id = page.id;

        item.append(heading, date, content, remove);
        container.appendChild(item);
    });
}

document.addEventListener("click", function (event) {
    const button = event.target.closest(".delete-saved-page");

    if (!button) return;

    const id = Number(button.dataset.id);
    const pages = readData("etherSavedPages", []);
    const updated = pages.filter(page => Number(page.id) !== id);

    writeData("etherSavedPages", updated);
    showSavedPages();
});

/* Make cards keyboard accessible and load saved pages */

document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".feature-card[data-feature]").forEach(function (card) {
        card.setAttribute("tabindex", "0");
        card.setAttribute("role", "link");
    });

    showSavedPages();
});
